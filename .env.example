APP_NAME="Rumah Sakit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging ke stderr agar ter-capture di Vercel function logs.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# === Database (TiDB Cloud Serverless — MySQL 8.0 compatible) ===
# TiDB Cloud Serverless default port is 4000 (bukan 3306).
# SSL wajib — set MYSQL_ATTR_SSL_CA ke system CA bundle Linux/Vercel.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem

# === Session / Cache / Queue ===
# Serverless-friendly drivers. Jangan pakai 'file' (read-only filesystem).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# === Filesystem (Vercel Blob) ===
# BLOB_READ_WRITE_TOKEN di-inject otomatis oleh Vercel saat Blob store dibuat.
FILESYSTEM_DISK=vercel-blob
BLOB_READ_WRITE_TOKEN=

# === Midtrans Payment Gateway ===
# Ganti ke production keys saat sudah siap live.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# === Vercel Cron Security ===
# Token yang dikirim Vercel di header Authorization: Bearer <token>.
# Generate via: openssl rand -hex 32
CRON_SECRET=

# === Mail (config ke provider SMTP seperti Resend, Postmark, SES) ===
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rumahsakit.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
