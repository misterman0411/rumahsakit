# Vercel upload filter — keeps the deployment bundle small and free of
# local-only artifacts. Order doesn't matter; patterns are evaluated against
# every file in the project root during `vercel deploy`.

# Dependencies
node_modules

# Local environment & secrets (NEVER upload .env)
.env
.env.*
!.env.example

# Laravel runtime artifacts that get rebuilt by deploy hooks.
# Keep the directories themselves (Laravel writes cache/sessions/views
# into them at runtime and refuses to boot if the path is missing), but
# exclude any cached files that might leak from a local environment.
# The .gitkeep placeholders force the directories to ship.
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/data/*
!storage/framework/cache/.gitkeep
!storage/framework/cache/data/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
storage/app/private/*
!storage/app/private/.gitkeep
storage/app/public/*
!storage/app/public/.gitkeep
!bootstrap/cache/.gitignore

# Tests & dev artifacts
tests
.phpunit.cache
.phpunit.result.cache
coverage

# Editor / OS noise
.git
.github
.gitattributes
.gitignore
.idea
.vscode
.DS_Store
Thumbs.db

# Documentation-only files (the deploy guide is published separately)
README.md
DEPLOY_*.md
LOGIN_CREDENTIALS.md
LICENSE
docs
*.log

# Build outputs that are uploaded via outputDirectory instead
public/build
public/hot
