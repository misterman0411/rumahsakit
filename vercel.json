{
  "version": 2,
  "framework": null,
  "buildCommand": "rm -f bootstrap/cache/*.php && composer dump-autoload --no-dev && npm run build",
  "outputDirectory": "public",
  "installCommand": "composer install --no-dev --optimize-autoloader && npm install",
  "env": {
    "APP_NAME": "Rumah Sakit",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://rumahsakit-vert.vercel.app",
    "APP_LOCALE": "id",
    "APP_FALLBACK_LOCALE": "id",
    "APP_FAKER_LOCALE": "id_ID",
    "APP_MAINTENANCE_DRIVER": "file",
    "BCRYPT_ROUNDS": "12",
    "LOG_CHANNEL": "stderr",
    "LOG_STACK": "single",
    "LOG_DEPRECATIONS_CHANNEL": "null",
    "LOG_LEVEL": "error",
    "DB_CONNECTION": "mysql",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "SESSION_ENCRYPT": "false",
    "SESSION_PATH": "/",
    "SESSION_DOMAIN": "null",
    "BROADCAST_CONNECTION": "log",
    "FILESYSTEM_DISK": "vercel-blob",
    "QUEUE_CONNECTION": "database",
    "CACHE_STORE": "database",
    "MAIL_MAILER": "log",
    "MAIL_FROM_ADDRESS": "noreply@rumahsakit.app",
    "MAIL_FROM_NAME": "Rumah Sakit",
    "MIDTRANS_IS_PRODUCTION": "false",
    "MIDTRANS_IS_SANITIZED": "true",
    "MIDTRANS_IS_3DS": "true",
    "VITE_APP_NAME": "Rumah Sakit",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
  },
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/cron/charge-rooms", "schedule": "1 0 * * *" }
  ]
}
